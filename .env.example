# Required only when RUN_DISCORD_BOT=true.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_REPLY_MODEL_FAST=
LLM_REPLY_MODEL_THINKING=
LLM_REPLY_MODEL_MODE=fast
LLM_REPLY_REASONING_EFFORT=
LLM_EXTRACTION_MODEL=
LLM_SUMMARY_MODEL=
# Enables provider-side prompt prefix caching where the selected backend supports it.
LLM_PROMPT_CACHING_ENABLED=true
LLM_BACKUP_MODEL=
LLM_SEARCH_MODEL=
LLM_NATIVE_SEARCH_ENABLED=true
LLM_NATIVE_SEARCH_TOOL_TYPE=web_search_preview
LLM_VISION_MODEL=
LLM_AUDIO_MODEL=whisper-1
LLM_IMAGE_MODEL=gpt-image-1
LLM_IMAGE_SIZE=1024x1024
LLM_TIMEOUT_SECONDS=60

DATABASE_PATH=data/shen_zhiwei.sqlite3
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/shen_zhiwei.log

HISTORY_MESSAGE_LIMIT=12
SESSION_MEMORY_LIMIT=8
LONG_TERM_MEMORY_LIMIT=8
FACT_LIMIT=12
SUMMARY_TRIGGER_MESSAGE_COUNT=12
SESSION_TIMEOUT_MINUTES=180

ALLOWED_CHANNEL_IDS=
DEBUG_PROMPTS=false
SINGLE_USER_MODE=false
SINGLE_USER_ID=primary_user
BOT_TIMEZONE=Asia/Shanghai

# 127.0.0.1 means the dashboard is only reachable on the server itself.
# If you need remote access, set 0.0.0.0, keep dashboard auth enabled,
# and explicitly acknowledge the public bind below.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8099
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=28800
DASHBOARD_SESSION_HTTPS_ONLY=false
DASHBOARD_PUBLIC_BIND_ACKNOWLEDGED=false
DASHBOARD_LOG_MAX_LINES=400
DASHBOARD_LOGIN_WINDOW_SECONDS=900
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_LOCKOUT_SECONDS=1800
DASHBOARD_PASSWORD_MIN_LENGTH=12

# Optional mobile API bearer token.
# Set this before exposing /mobile/* beyond localhost, then configure the same
# value in the iOS app Settings screen. Leave empty for localhost-only dev.
MOBILE_API_TOKEN=

RUN_DISCORD_BOT=false
RUN_BACKGROUND_WORKER=true

BACKGROUND_POLL_SECONDS=2
BACKGROUND_TASK_TIMEOUT_SECONDS=180
BACKGROUND_TASK_MAX_ATTEMPTS=3
HEALTHCHECK_INTERVAL_MINUTES=20
HEALTHCHECK_DEEP_INTERVAL_HOURS=12

# Proactive messages default to on, low frequency, and can be changed at runtime
# with `/proactive on|off|low|normal|high`, Dashboard, or the iOS Settings screen.
# Keep PROACTIVE_OPT_IN_REQUIRED=true if you need explicit `/proactive on` consent.
ENABLE_PROACTIVE_MESSAGES=true
PROACTIVE_OPT_IN_REQUIRED=false
PROACTIVE_IDLE_HOURS=18
PROACTIVE_SCAN_MINUTES=20
PROACTIVE_RESPONSE_WINDOW_HOURS=8
PROACTIVE_MIN_IDLE_MINUTES=12
PROACTIVE_MIN_INTERVAL_MINUTES=25
PROACTIVE_TRIGGER_DEDUPE_HOURS=6
PROACTIVE_FAILURE_BACKOFF_MINUTES=30

ATTACHMENT_TEXT_CHAR_LIMIT=2200
ATTACHMENT_TOTAL_CHAR_LIMIT=4200
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_IMAGE_MAX_BYTES=8388608
ATTACHMENT_AUDIO_MAX_BYTES=20971520
ATTACHMENT_DOCUMENT_MAX_BYTES=6291456
ATTACHMENT_ARTIFACT_STORE_TEXT=false
HUMAN_PRESENCE_ENABLED=true
HUMAN_MESSAGE_MAX_PARTS=3
HUMAN_TYPING_MIN_MS=650
HUMAN_TYPING_MAX_MS=3800
HUMAN_PART_DELAY_MIN_MS=450
HUMAN_PART_DELAY_MAX_MS=1800

COMPANION_DAY_ENGINE_ENABLED=true
DAY_STREAM_MIN_INTERVAL_MINUTES=180
DAY_STREAM_MAX_INTERVAL_MINUTES=240
DAY_DEEP_NIGHT_QUIET_ENABLED=true
DAY_STATUS_CARDS_ENABLED=false
DAY_TTS_ENABLED=false
DAY_GENERATED_IMAGE_ENABLED=false

REALITY_CONTEXT_ENABLED=true
WEATHER_PROVIDER=open_meteo
WEATHER_LOCATION_LABEL=Beijing
WEATHER_LATITUDE=39.9042
WEATHER_LONGITUDE=116.4074
CALENDAR_ICS_URLS=
CALENDAR_LOOKAHEAD_HOURS=48
REALITY_REFRESH_MINUTES=30

STREAMING_FLUSH_CHARS=72
STREAMING_MAX_SILENCE_MS=2200
OBSERVABILITY_RETENTION_DAYS=30
OBSERVABILITY_CONTENT_PREVIEW_CHARS=220
SEARCH_TIMEOUT_SECONDS=8
SEARCH_MAX_RESULTS=5
